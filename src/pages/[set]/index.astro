---
// Set home — design/canvas/SetHome.dc.html
import Base from "../../layouts/Base.astro";
import SectionNav from "../../components/SectionNav.astro";
import StatusChip from "../../components/StatusChip.astro";
import TopBar from "../../components/TopBar.astro";
import { shortSha, type BookSet } from "../../lib/content.ts";
import { FORMATS, LEVELS } from "../../lib/formats.ts";
import { getLibrary } from "../../lib/library.ts";

export function getStaticPaths() {
  return getLibrary().sets.map((set, index) => ({ params: { set: set.id }, props: { set, index } }));
}

interface Props {
  set: BookSet;
  index: number;
}

const { set, index } = Astro.props;
const fullTitle = `${set.title}, ${set.subtitle}`;
const firstArticle = set.chapters.find((c) => c.href)?.href;
const repoMap = set.chapters.flatMap((c) => c.articles).find((a) => a.format.code === "FG");
const drifted = set.chapters.filter((c) => c.status === "drifted");

function chipState(chapter: BookSet["chapters"][number], code: string) {
  if (chapter.articles.some((a) => a.format.code === code)) return "written";
  return chapter.plannedFormats.includes(code) ? "planned" : "none";
}
const chipLabel = { written: "available", planned: "planned", none: "not planned" };
---

<Base title={`${fullTitle} — Tales of Open Source`} description={set.blurb} accent={set.accent} accentHover={set.accentHover}>
  <TopBar crumbs={[{ label: fullTitle }]}>
    <SectionNav
      label="Sections"
      links={[
        { label: "Reading paths", href: "#paths" },
        { label: "Contents", href: "#contents" },
      ]}
    />
  </TopBar>

  <main class="page">
    <section class="hero grid-12">
      <div class="hero-main">
        <div class="eyebrow"><span class="eyebrow-swatch" aria-hidden="true"></span>Set {String(index + 1).padStart(2, "0")}</div>
        <h1>{set.title}, <span class="accent">{set.subtitle}</span></h1>
        <p class="lede">{set.description}</p>
        <div class="ctas">
          {firstArticle && <a class="cta primary" href={firstArticle}>Start reading</a>}
          {repoMap && <a class="cta" href={repoMap.href}>Open the repo map</a>}
        </div>
      </div>

      <aside class="truth" aria-labelledby="truth-title">
        <h2 id="truth-title" class="truth-title">Source of truth</h2>
        <dl>
          <div><dt>Repository</dt><dd class="mono"><a href={`https://github.com/${set.repo}`}>{set.repo}</a></dd></div>
          <div>
            <dt>Pinned commit</dt>
            <dd class="mono"><a href={`https://github.com/${set.repo}/commit/${set.pin.commit}`} title={set.pin.commit}>{shortSha(set.pin.commit)}</a></dd>
          </div>
          <div><dt>Release</dt><dd class="mono">{set.pin.release}</dd></div>
          <div><dt>Last synced</dt><dd>{set.pin.syncedAt}</dd></div>
          <div><dt>Tracked symbols</dt><dd>{set.trackedSymbolCount}</dd></div>
        </dl>
        {
          drifted.length > 0 ? (
            <a class="drift-alert" href={drifted[0].href ?? "#contents"}>
              <span>{drifted.length === 1 ? "1 chapter has drifted" : `${drifted.length} chapters have drifted`}</span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <p class="drift-note">Excerpts verified at the pin. Drift against upstream main is not checked yet.</p>
          )
        }
      </aside>
    </section>

    <section id="paths" class="paths" aria-label="Reading paths">
      {
        set.paths.map((path) => (
          <div class="path">
            <div class="path-who">
              <span aria-hidden="true">{LEVELS[path.level].pips} · </span>
              {LEVELS[path.level].name}
            </div>
            <h2 class="path-name">{path.name}</h2>
            <p class="path-what">{path.what}</p>
          </div>
        ))
      }
    </section>

    <section id="contents" class="contents" aria-labelledby="contents-title">
      <div class="contents-head">
        <h2 id="contents-title">Contents</h2>
        <ul class="legend" aria-label="Format codes">
          {
            FORMATS.map((f) => (
              <li>
                <span class="mono legend-code">{f.code}</span>
                {f.name}
              </li>
            ))
          }
        </ul>
      </div>

      {
        set.parts.map((part) => (
          <div class="part">
            <div class="part-head">
              <div class="part-num mono">PART {part.num}</div>
              <h3 class="part-title">{part.title}</h3>
            </div>
            <ul class="chapters">
              {part.chapters.map((chapter) => {
                const inner = (
                  <>
                    <span class="ch-num mono">{chapter.num}</span>
                    <span class="ch-title">
                      <span class="ch-name">{chapter.title}</span>
                      <span class="ch-path mono">{chapter.pathHint}</span>
                    </span>
                    <span class="ch-formats">
                      {FORMATS.map((f) => {
                        const state = chipState(chapter, f.code);
                        return (
                          <span class:list={["fchip", "mono", state]}>
                            <span aria-hidden="true">{f.code}</span>
                            <span class="visually-hidden">{`${f.name}: ${chipLabel[state]}`}</span>
                          </span>
                        );
                      })}
                    </span>
                    <span class="ch-status">
                      <StatusChip status={chapter.status} />
                    </span>
                  </>
                );
                return <li>{chapter.href ? <a class="chapter" href={chapter.href}>{inner}</a> : <div class="chapter">{inner}</div>}</li>;
              })}
            </ul>
          </div>
        ))
      }
      <p class="chip-key">
        <span class="fchip mono written" aria-hidden="true">GT</span> written
        <span class="fchip mono planned" aria-hidden="true">QT</span> planned in the outline
      </p>
    </section>
  </main>
</Base>

<style>
  main {
    font-family: var(--font-display);
    padding-bottom: 96px;
  }
  .hero {
    padding: 0 var(--gutter);
    row-gap: 32px;
  }
  .hero-main {
    grid-column: span 7;
    padding: 88px 0 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-size: clamp(52px, 7.2vw, 92px);
    line-height: 0.96;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .accent {
    font-weight: 400;
    color: var(--accent);
  }
  .lede {
    margin: 0;
    font-size: 22px;
    line-height: 1.5;
    color: var(--color-textSecondary);
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 15px;
  }
  .cta {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    text-decoration: none;
  }
  .cta:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .cta.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-onAccent);
    font-weight: 500;
  }
  .cta.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .truth {
    grid-column: 9 / span 4;
    margin-top: 88px;
    align-self: start;
    background: var(--color-invertedBg);
    color: var(--color-invertedText);
    border-radius: var(--radius-lg);
    padding: 28px;
    font-family: var(--font-body);
    font-size: 14px;
  }
  .truth-title {
    margin: 0;
    padding-bottom: 12px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-invertedMuted);
  }
  .truth dl {
    margin: 0;
  }
  .truth dl > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--color-invertedRule);
  }
  .truth dt {
    color: var(--color-invertedMuted);
  }
  .truth dd {
    margin: 0;
  }
  .truth a {
    color: var(--color-invertedText);
  }
  .drift-alert {
    margin-top: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 12px 14px;
    background: var(--color-status-drifted);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
  }
  .truth .drift-alert {
    color: var(--color-status-driftedText);
  }
  .drift-note {
    margin: 12px 0 0;
    padding: 12px 14px;
    border: 1px dashed var(--color-invertedMuted);
    border-radius: var(--radius-md);
    color: var(--color-invertedMuted);
    line-height: 1.5;
  }

  .paths {
    margin: 0 var(--gutter);
    padding: 40px 0;
    border-top: 2px solid var(--color-text);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    font-family: var(--font-body);
  }
  .path {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .path-who {
    font-size: 13px;
    color: var(--color-textMuted);
  }
  .path-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
  }
  .path-what {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-textSecondary);
  }

  .contents {
    padding: 40px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .contents-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    padding-bottom: 16px;
  }
  .contents-head h2 {
    margin: 0;
    font-size: 48px;
    font-weight: 500;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-textSecondary);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend-code {
    font-weight: 500;
  }
  .part {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--color-text);
  }
  .part-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .part-num {
    font-size: 12px;
    color: var(--accent);
  }
  .part-title {
    margin: 0;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.1;
  }
  .chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chapter {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 260px 120px;
    gap: 16px;
    align-items: center;
    min-height: 56px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: var(--color-text);
  }
  a.chapter:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  a.chapter:hover .ch-name {
    text-decoration: underline;
  }
  .ch-num {
    font-size: 13px;
    color: var(--color-textMuted);
  }
  .ch-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ch-name {
    font-size: 20px;
  }
  .ch-path {
    font-size: 12px;
    color: var(--color-textMuted);
  }
  .ch-formats {
    display: flex;
    gap: 4px;
  }
  .fchip {
    width: 38px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: 11px;
  }
  .fchip.written {
    background: var(--color-invertedBg);
    color: var(--color-invertedText);
  }
  .fchip.planned {
    border: 1px dashed var(--color-textSecondary);
    color: var(--color-textSecondary);
  }
  .fchip.none {
    border: 1px dashed var(--color-dashed);
    color: var(--color-textFaint);
  }
  .ch-status {
    justify-self: end;
  }
  .chip-key {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-textMuted);
  }
  .chip-key .fchip:not(:first-child) {
    margin-left: 12px;
  }

  @media (max-width: 1000px) {
    .hero-main,
    .truth {
      grid-column: 1 / -1;
    }
    .hero-main {
      padding: 56px 0 0;
    }
    .truth {
      margin-top: 0;
      margin-bottom: 48px;
    }
    .part {
      grid-template-columns: minmax(0, 1fr);
    }
    .chapter {
      grid-template-columns: 32px minmax(0, 1fr) auto;
    }
    .ch-formats {
      grid-column: 2 / -1;
      grid-row: 2;
      flex-wrap: wrap;
    }
  }
</style>
