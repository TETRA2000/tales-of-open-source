---
// One article: the chapter told in one format. Shared chrome here; the body is
// rendered by the format's renderer (only Guided Trace so far).
import Base from "../../../layouts/Base.astro";
import FormatSwitcher from "../../../components/FormatSwitcher.astro";
import GuidedTrace from "../../../components/GuidedTrace.tsx";
import MetaChips from "../../../components/MetaChips.astro";
import TopBar from "../../../components/TopBar.astro";
import type { Article, BookSet, Chapter } from "../../../lib/content.ts";
import { getLibrary } from "../../../lib/library.ts";

export function getStaticPaths() {
  return getLibrary().sets.flatMap((set) =>
    set.chapters.flatMap((chapter) =>
      chapter.articles.map((article) => ({
        params: { set: set.id, chapter: chapter.id, format: article.format.slug },
        props: { set, chapter, article },
      })),
    ),
  );
}

interface Props {
  set: BookSet;
  chapter: Chapter;
  article: Article;
}

const { set, chapter, article } = Astro.props;
const setTitle = `${set.title}, ${set.subtitle}`;
---

<Base
  title={`${article.title} — ${article.format.name} — ${setTitle}`}
  description={`${chapter.title}, told as a ${article.format.name}.`}
  accent={set.accent}
  accentHover={set.accentHover}
>
  <TopBar crumbs={[{ label: setTitle, href: set.href }, { label: `${chapter.part.num} · ${chapter.title}` }]}>
    <FormatSwitcher chapter={chapter} current={article.format.code} />
  </TopBar>

  <main class="page">
    <section class="head grid-12">
      <div class="head-main">
        <div class="eyebrow"><span class="eyebrow-swatch" aria-hidden="true"></span>{article.format.name} · {set.title}</div>
        <h1>{article.title}</h1>
        <MetaChips article={article} repo={set.repo} />
      </div>
      {
        article.body.format === "GT" && (
          <aside class="example" aria-label={article.body.data.example.label}>
            <div class="example-label">{article.body.data.example.label}</div>
            <div class="example-request mono">{article.body.data.example.request}</div>
            <div class="example-target mono">→ {article.body.data.example.target}</div>
          </aside>
        )
      }
    </section>

    {article.body.format === "GT" && <GuidedTrace client:load steps={article.body.data.steps} />}
  </main>
</Base>

<style>
  .head {
    padding: 56px var(--gutter) 40px;
    align-items: end;
    row-gap: 24px;
  }
  .head-main {
    grid-column: span 8;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.04;
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }
  .example {
    grid-column: 9 / span 4;
    min-width: 0;
    padding: 18px 20px;
    background: var(--color-invertedBg);
    color: var(--color-invertedText);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .example-label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-invertedMuted);
  }
  .example-request {
    font-size: 15px;
  }
  .example-target {
    font-size: 13px;
    color: var(--color-invertedMuted);
  }
  /* Code-like strings (SQL, constants) have few spaces; let them break anywhere. */
  .example-request,
  .example-target {
    overflow-wrap: anywhere;
  }
  @media (max-width: 900px) {
    .head-main,
    .example {
      grid-column: 1 / -1;
    }
  }
</style>
