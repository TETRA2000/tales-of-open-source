---
// What each field group of the struct is for, then the struct's source at the
// pin, collapsed so the card stays the focus.
import CodePanel from "../CodePanel.tsx";
import type { AnatomyBody } from "../../lib/anatomy.ts";

interface Props {
  struct: AnatomyBody["struct"];
}

const { struct } = Astro.props;
---

<div class="struct-legend">
  <ul class="groups">
    {
      struct.groups.map((group) => (
        <li class="group">
          <span class="group-key mono" aria-hidden="true">
            {group.key}
          </span>
          <div class="group-text">
            <h3 class="group-name">
              <span class="visually-hidden">{group.key}: </span>
              {group.name}
            </h3>
            <p class="group-what">{group.what}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <details class="source">
    <summary>Source at pin</summary>
    <CodePanel source={struct.source} />
  </details>
</div>

<style>
  .struct-legend {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .groups {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .group {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .group:first-child {
    padding-top: 0;
  }
  .group-key {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
  }
  .group-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .group-name {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 28px;
  }
  .group-what {
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.5;
    color: var(--color-textSecondary);
  }
  .source {
    margin-top: 16px;
  }
  summary {
    min-height: 44px;
    padding: 12px 0;
    line-height: 20px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  summary:hover {
    color: var(--accent-hover);
  }
  .source[open] summary {
    margin-bottom: 8px;
  }
</style>
