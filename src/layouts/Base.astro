---
import tokens from "../../design/tokens.json";
import { tokensToCss } from "../lib/tokens";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  accent?: string;
  accentHover?: string;
}

const { title, description, accent, accentHover } = Astro.props;
const themeCss = tokensToCss(tokens);
const accentStyle = [accent && `--accent: ${accent}`, accentHover && `--accent-hover: ${accentHover}`]
  .filter(Boolean)
  .join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={tokens.font.googleFontsHref} />
    <style is:inline set:html={themeCss}></style>
  </head>
  <body style={accentStyle || undefined}>
    <slot />
  </body>
</html>
